{# Get field link value #}
{% set link = content.field_link['#items'].0.uri %}

{# Verify if the url is internal o external #}
{% if link starts with 'internal:' %}
  {# Internal URL #}
  {% set internalPath = link | replace({'internal:': ''}) %}
  {% set url = file_url(internalPath) %}
{% else %}
  {# External URL #}
  {% set url = link %}
{% endif %}

{% if content.field_image['#items'].value %}
  {# Get field image value #}
  {% set imagen = content.field_image['#items'].entity %}

    {# Print the image #}
    <a href="{{ url }}" target="_blank">
      <img src="{{ file_url(imagen.field_media_image.entity.fileuri) }}" alt="{{ imagen.field_descripcion.value }}">
    </a>
{% endif %}
