{# Header region #}
{% block header %}
    <div class="header">
        {{ page.header }}
    </div>
{% endblock %}

{# Messages region #}
{% block messages %}
    <div class="messages">
        {{ page.messages }}
    </div>
{% endblock %}

{# Contact form region #}
{% include directory ~ '/templates/includes/contact-form.html.twig' %}

{# Content region #}
{% block content %}
    <div class="content">
        {{ page.content }}
    </div>
{% endblock %}

{# Footer region #}
{% include directory ~ '/templates/includes/footer.html.twig' %}
{% include directory ~ '/templates/includes/blob.html.twig' %}