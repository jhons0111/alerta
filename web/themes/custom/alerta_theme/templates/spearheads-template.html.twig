<article class="personality-animation" data-aos="personality">
    <h2 class="Strenuous difuminate animation-tx-reveal">
        {{ first_title|raw }}
    </h2>
    <h3 class="animation-tx-reveal">
        {{ second_title|raw }}
    </h3>
</article>
<article class="personality-animation" data-aos="personality" id="grid-projects">
    {% for key, item in projects %}
        <div class="item"  style='--index:0.{{ loop.index }}s'>
            <picture>
                <img src="{{ item.image|raw }}" alt="icon project">
            </picture>
            <div class="hovered">
                <div class="container">
                    <picture>
                        <img src="{{ item.image|raw }}" alt="image hover">
                    </picture>
                    <div class="categories">
                        <div class="block">
                            <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-light.svg" alt="icon">
                        </div>
                        {% if item.badges %}
                            <div class="block">
                            {% for key, item in item.badges %}
                                    <img src="{{ item.image_url }}" alt="{{ item.alt }}">
                            {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
                <div class="content">
                    <h5>{{ item.title|raw }}</h5>
                    <p>{{ item.description|raw }}</p>
                </div>
            </div>
        </div>  
    {% endfor %}
    <div id="show-more">
        <p>See more</p>
        <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-down.svg" alt="">
    </div>
</article>
