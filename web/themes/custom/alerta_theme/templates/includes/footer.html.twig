<footer class="footer">
    <!--Content-->
    <div class="footer__content">
        <div class="block-content">
            <div class="item__networks">
                <p class="social__media">Social media</p>
                <div class="social__networks">
                    {% block first_footer %}
                            {{ page.first_footer }}
                    {% endblock %}
                </div>
            </div>
            <div class="item__email">
                <picture>

                    <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/email.svg" alt="email icon">
                </picture>
                <div class="footer__contact">
                    {% block second_footer %}
                            {{ page.second_footer }}
                    {% endblock %}
                </div>
            </div>
        </div>
        <!--Block map-->
        <div class="block-map">
            <div class="map">
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/jpg/Basemap-image.jpg" alt="map">
            </div>
            <div class="block">
                <div class="certified">
                    <p>CERTIFIED BY</p>
                </div>
                <picture class="image-certify">
                    <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-bnsdc.svg" alt="certify">
                </picture>
                <div class="find">
                    <p>Find us</p>
                    <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/certify.svg" alt="certify">
                </div>
            </div>
        </div>
        <!--End block map-->
    </div>
    <!--End content-->
    <!--Copyright-->
    <div class="footer__copyrigth">
        {% block sub_footer %}
                {{ page.sub_footer }}
        {% endblock %}
    </div>
    <!--End copyright-->
</footer>