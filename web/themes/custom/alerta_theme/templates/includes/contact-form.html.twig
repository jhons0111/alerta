<section class="join-us ctm-inputs" id="join-form-ctn">
    <div class="join-us__bg"></div>
    <div class="join-us__content">
        <article id="open-form">
            <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/star.svg" alt="star icon">
        </article>
        <!--Content form-->
        <article id="join-form">
            <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/line.svg" alt="line">
            {% block contact_form %}
                <div class="contact-form">
                    {{ page.contact_form }}
                </div>
            {% endblock %}
        </article>
    </div>
    <!--End content form-->
</section>