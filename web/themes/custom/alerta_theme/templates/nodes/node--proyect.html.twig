
<main class="main-content" id="main">
    <!-- Stars -->
    {# <section class="stars__container">
        <div id='stars'></div>
        {% for i in 1..3 %}
            <div id='stars{{ i }}'></div>
        {% endfor %}
    </section> #}
    <section class="stars__container">
        <canvas id="galaxy" width="100%" height="100%"></canvas>
    </section>
    <!--End stars-->

    <!--Video-->
    <section class="detail-project" data-aos="personality">
        <article>
            <iframe src="{{ node.field_project_banner_url.value|raw }}" frameborder="0"></iframe>
        </article>
    </section>
    <!-- End video-->
    <!--Contain with icons-->
    <section class="detail-project__hero">
        <div class="block ctn">
            <article class="container" data-aos="fade-up" >
                <picture>
                    {% set brand_logo = file_url(node.field_project_brand_logo.entity.field_media_image.entity.fileuri) %}
                    <img src="{{ brand_logo }}" alt="brand">
                </picture>
            </article>
            <article class="container" data-aos="fade-up" data-aos-delay="100">
                <p>
                    {{ node.field_project_description.value|raw }}
                </p>
                <h5>Campaigns</h5>
                <div class="item">
                    {% for category in node.field_project_categories %}
                        <a href="#" class="btn btn--tertiary">{{ category.value }}</a>
                        {# <a href="#" class="btn btn--tertiary">{{ category.value }}</a> #}
                    {% endfor %}
                </div>
            </article>
            <article class="container" data-aos="fade-up" data-aos-delay="200">
                <picture>
                    <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-test.svg" alt="icon">
                </picture>
            </article>
        </div>
        <article class="project-gradient" data-aos="fade-up" data-aos-delay="300">
            <picture>
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/gradient-project.png" alt="background">
            </picture>
        </article>
    </section>
    <!--End contain with icons-->

    <!--Line animate-->
    <section class="home-line home-line--relative project-line personality-animation" data-aos="personality">
        <!--Svg module-->
        <svg xmlns="http://www.w3.org/2000/svg" width="1920" height="465" viewBox="0 0 1920 465" fill="none">
            <path  id="pathHome3" d="M-41.5318 108.835C-37.212 63.8059 -5.98969 -19.2352 84.3419 8.83132C197.256 43.9145 190.199 274.605 435.38 244.052C680.561 213.5 723.373 53.4216 970.188 162.961C1217 272.5 1391.33 503.549 1644.15 455.051C1896.98 406.552 1856.74 248.01 1984.23 260.24" stroke="url(#paint0_linear_1735_14458)" stroke-width="6"/>
            <path  id="pathHome3" d="M-41.5318 108.835C-37.212 63.8059 -5.98969 -19.2352 84.3419 8.83132C197.256 43.9145 190.199 274.605 435.38 244.052C680.561 213.5 723.373 53.4216 970.188 162.961C1217 272.5 1391.33 503.549 1644.15 455.051C1896.98 406.552 1856.74 248.01 1984.23 260.24" stroke="url(#paint1_linear_1735_14458)" stroke-width="6"/>
            <defs>
            <linearGradient id="paint0_linear_1735_14458" x1="1072.71" y1="-63.4724" x2="997.476" y2="410.785" gradientUnits="userSpaceOnUse">
            <stop stop-color="#0052F1"/>
            <stop offset="1" stop-color="#0052F1" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="paint1_linear_1735_14458" x1="1471.32" y1="566.768" x2="1326.14" y2="-113.568" gradientUnits="userSpaceOnUse">
            <stop stop-color="#9747FF"/>
            <stop offset="1" stop-color="#9747FF" stop-opacity="0"/>
            </linearGradient>
            </defs>
        </svg>
        <!--End svg module-->
    </section>
    <!--End line animate-->

    {# Body #}
    {% for key, item in content.field_section_left_side if key|first != '#'%}
    
        {% set paragraph_type_machine_name = item['#paragraph'].getType() %}
        {% if paragraph_type_machine_name == 'title_and_description' %}

            <section class="text-content">
                {% if item['#paragraph'].field_elements_order[0].value|raw == 'left' %}

                        <!--Title and text section left-->
                        <div class="text-content-title text-content-title">
                            <div class="text-content-title-raw text-content-title-raw_left">
                                {% set title_img = file_url(item['#paragraph'].field_image.entity.field_media_image.entity.fileuri) %}
                                {% set title_alt = file_url(item['#paragraph'].field_image.entity.field_media_image.entity.alt) %}
                                <img src="{{ title_img }}" alt="{{ title_alt }}" data-aos="fade-left">
                            </div>
                        </div>
                        <div class="text-content-paragraphs">
                            <div class="text-content-paragraphs-raw text-content-paragraphs-raw_left">
                                <span data-aos="fade-left">
                                    {{ item['#paragraph'].field_project_desc_parag[0].value|raw }}
                                </span>
                            </div>
                        </div>
                        <!--End Title and text section left-->
                {% elseif item['#paragraph'].field_elements_order[0].value|raw == 'right' %}

                    <!--Title and text section right-->
                    <section class="text-content">
                        <div class="text-content-title">
                            <div class="text-content-title-raw text-content-title-raw_right">
                                {% set title_img = file_url(item['#paragraph'].field_image.entity.field_media_image.entity.fileuri) %}
                                {% set title_alt = file_url(item['#paragraph'].field_image.entity.field_media_image.entity.fileuri) %}
                                <img src="{{ title_img }}" alt="{{ title_alt }}" data-aos="fade-right">
                            </div>
                        </div>
                        <div class="text-content-paragraphs">
                            <div class="text-content-paragraphs-raw text-content-paragraphs-raw_right">
                                <span data-aos="fade-right">
                                    {{ item['#paragraph'].field_project_desc_parag[0].value|raw }}
                                </span>
                            </div>
                        </div>
                    </section>
                    <!--End Title and text section right-->
                {% endif %}
            </section>
        {% elseif paragraph_type_machine_name == 'only_video' %}

            <!--Video-->
            <section class="detail-project detail-project-body" data-aos="slide-up">
                <article>
                    <iframe src="{{ item['#paragraph'].field_video_link[0].value|raw }}" frameborder="0"></iframe>
                </article>
            </section>
            <!-- End video-->
        {% endif %}
    {% endfor %}
    {# End body #}
    {% include directory ~ '/templates/includes/loader.html.twig' %}

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/1.7.1/jquery.min.js" type="text/javascript"></script>
    <script>
        var WIDTH, HEIGHT, canvas, con, g;
        var pxs = [];
        var rint = 70;
        $(document).ready(function() {
            var windowSize = function() {
                WIDTH = $('.stars__container').innerWidth();
                HEIGHT = $('.stars__container').innerHeight();
                canvas = $('#galaxy');
                canvas.attr('width', WIDTH).attr('height', HEIGHT);
            };
        
            windowSize();
        
            $(window).resize(function() {
                windowSize();
            });

            con = canvas[0].getContext('2d');
            for (var i = 0; i < 100; i++) {
                pxs[i] = new Circle();
                pxs[i].reset();
            }
            requestAnimationFrame(draw);
        });

        function draw() {
            con.clearRect(0, 0, WIDTH, HEIGHT);
            con.globalCompositeOperation = "lighter";
            for (var i = 0; i < pxs.length; i++) {
                pxs[i].fade();
                pxs[i].move();
                pxs[i].draw();
            }
            requestAnimationFrame(draw);
        }

        function Circle() {
            this.s = {
                ttl: 15000,
                xmax: 5,
                ymax: 2,
                rmax: 17,
                rt: 1,
                xdef: 960,
                ydef: 540,
                xdrift: 2,
                ydrift: 2,
                random: true,
                blink: true
            };
            this.reset = function() {
                this.x = (this.s.random ? WIDTH * Math.random() : this.s.xdef);
                this.y = (this.s.random ? HEIGHT * Math.random() : this.s.ydef);
                this.r = ((this.s.rmax - 1) * Math.random()) + 1;
                this.dx = (Math.random() * this.s.xmax) * (Math.random() < 0.5 ? -1 : 1);
                this.dy = (Math.random() * this.s.ymax) * (Math.random() < 0.5 ? -1 : 1);
                this.hl = (this.s.ttl / rint) * (this.r / this.s.rmax);
                this.rt = Math.random() * this.hl;
                this.s.rt = Math.random() + 1;
                this.stop = Math.random() * 0.2 + 0.4;
                this.s.xdrift *= Math.random() * (Math.random() < 0.5 ? -1 : 1);
                this.s.ydrift *= Math.random() * (Math.random() < 0.5 ? -1 : 1);
            };
            this.fade = function() {
                this.rt += this.s.rt;
            };
            this.draw = function() {
                if (this.s.blink && (this.rt <= 0 || this.rt >= this.hl)) this.s.rt = this.s.rt * -1;
                else if (this.rt >= this.hl) this.reset();
                var newo = 1 - (this.rt / this.hl);
                con.beginPath();
                con.arc(this.x, this.y, this.r, 0, Math.PI * 2, true);
                con.closePath();
                var cr = this.r * newo;
                g = con.createRadialGradient(this.x, this.y, 0, this.x, this.y, (cr <= 0 ? 1 : cr));
                g.addColorStop(0.0, 'rgba(255,255,255,' + newo + ')');
                g.addColorStop(this.stop, 'rgba(255,255,255,' + (newo * 0.2) + ')');
                g.addColorStop(1.0, 'rgba(193,254,254,0)');
                con.fillStyle = g;
                con.fill();
            };
            this.move = function() {
                this.x += (this.rt / this.hl) * this.dx;
                this.y += (this.rt / this.hl) * this.dy;
                if (this.x > WIDTH || this.x < 0) this.dx *= -1;
                if (this.y > HEIGHT || this.y < 0) this.dy *= -1;
            };
            this.getX = function() {
                return this.x;
            };
            this.getY = function() {
                return this.y;
            };
        };
    </script>
</main>