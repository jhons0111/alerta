<main class="main-content" id="main">
    <!-- Stars -->
    <section class="stars__container">
        <canvas id="galaxy" width="100%" height="100%"></canvas>
        {# <div id='stars'></div>
        {% for i in 1..3 %}
            <div id='stars{{ i }}'></div>
        {% endfor %} #}
    </section>
    <!--End stars-->

    <section class="home-certified" data-aos="personality">
        <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/nmsdc.svg">
    </section>

    <section class="home-asteroid">
        <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/asteroid.png" alt="">
    </section>

    <!--Title-->
    <section class="home ctm-fonts personality-animation" data-aos="personality">
        <article class="animation-tx-reveal">
            <h1 class="block-animation Strenuous">
                <span style="--index:0.1s">A</span>
                <span style="--index:0.15s">L</span>
                <span style="--index:0.2s">E</span>
                <span style="--index:0.25s">R</span>
                <span style="--index:0.3s">T</span>
                <span style="--index:0.35s">A</span>
                <span style="--index:0.4s">!</span>
            </h1>
            <h2 class="block-animation etna">
                <span style="--index:0.45s">h</span>
                <span style="--index:0.5s">e</span>
                <span style="--index:0.55s">l</span>
                <span style="--index:0.6s">p</span>
                <span style="--index:0.65s">s</span>
            </h2>
        </article>
        <article class="animation-tx-reveal">
            <h3 class="block-animation Strenuous">
                <span style="--index:0.4s">V</span>
                <span style="--index:0.45s">I</span>
                <span style="--index:0.5s">S</span>
                <span style="--index:0.55s">I</span>
                <span style="--index:0.6s">O</span>
                <span style="--index:0.65s">N</span>
                <span style="--index:0.7s">A</span>
                <span style="--index:0.75s">R</span>
                <span style="--index:0.8s">Y</span>
            </h3>
            <h3 class="block-animation Strenuous">
                <span style="--index:0.7s">B</span>
                <span style="--index:0.75s">R</span>
                <span style="--index:0.8s">A</span>
                <span style="--index:0.85s">N</span>
                <span style="--index:0.9s">D</span>
                <span style="--index:0.95s">S</span>
            </h3>
        </article>
        <article class="animation-tx-reveal">
            <h3 class="block-animation etna">
                <span style="--index:0.4s">c</span>
                <span style="--index:0.45s">h</span>
                <span style="--index:0.5s">a</span>
                <span style="--index:0.55s">l</span>
                <span style="--index:0.6s">l</span>
                <span style="--index:0.65s">e</span>
                <span style="--index:0.7s">n</span>
                <span style="--index:0.75s">g</span>
                <span style="--index:0.8s">e</span>
            </h3>
            <h3 class="block-animation globs">
                <span style="--index:0.7s">t</span>
                <span style="--index:0.75s">h</span>
                <span style="--index:0.8s">e</span>
                <span style="--index:0.85s">i</span>
                <span style="--index:0.9s">r</span>
            </h3>
            <h3 class="block-animation globs">
                <span style="--index:0.7s">l</span>
                <span style="--index:0.75s">i</span>
                <span style="--index:0.8s">m</span>
                <span style="--index:0.85s">i</span>
                <span style="--index:0.9s">t</span>
                <span style="--index:0.95s">s</span>
            </h3>
        </article>
    </section>
    <!--End-->

    <!-- Indicator scroll down -->
    {% include directory ~ '/templates/includes/scroll-down.html.twig' %}
    <!-- End indicator scroll down -->

    <!--Line animate-->
    <section class="home-line personality-animation" data-aos="personality">
        <!--Svg module-->
        <svg xmlns="http://www.w3.org/2000/svg" width="1920" height="658" viewBox="0 0 1920 658" fill="none" id="line-animate-home">
            <path id="pathHome1" d="M-72.7156 179.428C-65.717 106.475 -29.4229 -29.4339 59.765 10.5541C171.25 60.539 150.554 433.401 398.922 369.621C647.291 305.842 699.782 44.8742 941.535 207.174C1183.29 369.474 1344.98 732.223 1602.09 639.019C1859.21 545.815 1828.09 292.223 1955.58 304.453" stroke="url(#paint0_linear_404_114)" stroke-width="6"/>
            <path id="pathHome2" d="M-72.7156 179.428C-65.717 106.475 -29.4229 -29.4339 59.765 10.5541C171.25 60.539 150.554 433.401 398.922 369.621C647.291 305.842 699.782 44.8742 941.535 207.174C1183.29 369.474 1344.98 732.223 1602.09 639.019C1859.21 545.815 1828.09 292.223 1955.58 304.453" stroke="url(#paint1_linear_404_114)" stroke-width="6"/>
            <defs>
                <linearGradient id="paint0_linear_404_114" x1="1057.99" y1="-164.443" x2="907.414" y2="596.381" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#0052F1"/>
                    <stop offset="1" stop-color="#0052F1" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="paint1_linear_404_114" x1="1421.69" y1="829.573" x2="1034.09" y2="-148.635" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#9747FF"/>
                    <stop offset="1" stop-color="#9747FF" stop-opacity="0"/>
                </linearGradient>
            </defs>
        </svg>
        <!--End svg module-->
    </section>
    <!--End line animate-->

    <!--RGB-->
    <section class="gradient gradient--top">
        <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/gradient-top.png" />
    </section>
    <!--End RGB-->

    <!--Planet three js-->
    <section class="home-planet personality-animation ctm-fonts ctn" data-aos="personality">
        <article data-aos="personality">
            <canvas id="canvas-hero"></canvas>
        </article>
        <article class="animation-tx-reveal-secondary">
            <h5 class="rift">
                {{ node.field_home_initial_text.value|raw }}
            </h5>
        </article>
    </section>
    <!--End planet three js-->

    <!--alert makes-->
    <section class="home-effective ctn ctm-fonts">
        <article>
            <picture data-aos="fade-up">
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-test.svg" alt="icon">
            </picture>
            <picture data-aos="fade-up" data-aos-delay="100">
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-test.svg" alt="icon">
            </picture>
            <em data-aos="personality">
                <b></b>
            </em>
        </article>
        <article>
            <div class="block personality-animation" data-aos="personality">
                {# <h2 class="Strenuous difuminate animation-tx-reveal">
                    AQUI
                </h2> #}
                <div class="block-makes" data-aos="fade-left">
                    <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/alerta-makes.png">
                </div>
                <h3 class="Strenuous animation-tx-reveal">
                    {{ node.field_home_makes_second_text.value|raw }}
                </h3>
                <h4 class="animation-tx-reveal">
                    {{ node.field_home_makes_third_text.value|raw }}
                </h4>
            </div>
            <div class="block" data-aos="personality">
                <picture>
                    {% set main_img_url = file_url(node.field_main_home_image.entity.field_media_image.entity.fileuri) %}
                    {% set main_img_alt = file_url(node.field_main_home_image.entity.field_media_image.entity.alt) %}
                    <img src="{{ main_img_url }}" alt="{{ main_img_alt }}">
                </picture>
            </div>
        </article>
        <article data-aos="personality">
            {% set img_media_arr = node.field_home_image %}
            {% for img_item in img_media_arr %}
              
              {# Get the image url #}
              {% set img_uri = file_url(img_item.entity.field_media_image.entity.fileuri) %}
              {% set img_alt = img_item.entity.field_media_image.alt %}
              <div class="item">
                  <picture>
                      <img src="{{ img_uri }}" alt="{{ img_alt }}">
                  </picture>
              </div>
            {% endfor %}
        </article>
        <article data-aos="personality">
            <picture>
                <img class="star" src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/start-makes.svg" alt="star">
                <img class="expansive" src="/themes/custom/alerta_theme/sources/dist/assets/img/png/expansive.png" alt="Expansive image">
            </picture>
        </article>
    </section>
    <!--End alert makes-->

    <!--Line animate-->
    <section class="home-line home-line--relative personality-animation" data-aos="personality">
        <!--Svg module-->
        <svg id="pathHome3" xmlns="http://www.w3.org/2000/svg" width="1920" height="382" viewBox="0 0 1920 382" fill="none">
            <path d="M-56.5046 180.62C-57.2435 124.162 32.5126 23.6362 79.1784 89.5564C252.25 334.038 334.433 100.422 495.326 53.3174C735.569 -17.0187 653.617 588.469 1098.57 304.889C1323.69 161.413 1454.32 388.965 1621.47 83.0898C1727.86 -111.588 1845.52 102.38 1973.58 100.704" stroke="white" stroke-width="2"/>
        </svg>
        <!--End svg module-->
    </section>
    <!--End line animate-->

    <!--RGB-->
    <section class="gradient gradient--left-blue-light">
        <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/left-blue-light.png" alt="">
    </section>
    <!--End RGB-->

    <!--Project grid-->
    <section class="home-grid ctn ctm-fonts">
        {{ spearheads_template }}
    </section>
    <!--End projects grid-->

    <!-- Categories-->
    <section class="home-categories">
        {{ badges_template }}
    </section>
    <!-- End categories-->

    <!-- Team -->
    <section class="home-team ctn">
        <article  class="personality-animation" data-aos="personality">
            <picture>
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/jpg/image-team.jpg" alt="">
            </picture>
            <em>
                <img src="" alt="">
                <b></b>
            </em>
            <div>
                <em></em>
                <h2 class="animation-tx-reveal">
                    {{ node.field_home_team_title.value|raw }}
                </h2>
                <h4 class="animation-tx-reveal">
                    {{ node.field_home_team_sec_title.value|raw }}
                </h4>
            </div>
            <div class="team-lines">
                <em class="line-team"></em>  
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/svg/icon-team.svg" alt="">
                <em class="line-team-bottom">
                <b></b>
                </em>
                <p>Wielding our proprietary communication super weapon</p>
            </div>
        </article>
        <article class="personality-animation" data-aos="personality" id="render-team">
            <p>Click on the circles to meet the crew</p>
        </article>
    </section>
    <!-- Team -->

    <!--Parallax-->
    <section class="parallax">
        <div class="item">
            <p>TALENT</p>
            <em></em>
            <p>FORCE</p>
            <em></em>
        </div>
        <article>
            {% for i in 1..7 %}
                <div style="--top: {{i * 2.5}}"></div>
            {% endfor %}
        </article>
    </section>
    <section class="parallax parallax--rigth">
        <div class="item">
            <p>TALENT</p>
            <em></em>
            <p>FORCE</p>
            <em></em>
        </div>
        <article>
            {% for i in 1..7 %}
                <div style="--top: {{i * 2.5}}"></div>
            {% endfor %}
        </article>
    </section>
    <!--End arallax-->

    <!--RGB-->
    <section class="gradient gradient--left-green-light">
        <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/left-green-light.png" alt="">
    </section>
    <!--End RGB-->

    <!-- Planet with message alert-->
    <section class="home-alert ctm-fonts">
        <article class="personality-animation" data-aos="personality">
            <div id="mark-circle">
                <img src="/themes/custom/alerta_theme/sources/dist/assets/img/png/circle-mark.png" alt="">
            </div>
        </article>
        <article class="personality-animation" data-aos="personality">
            <div class="animation-tx-reveal">
                <h4 class="globs">
                    <span style="--index:0.1s" 
                    data-title="Assess"
                    data-description="We do a deep dive into the current situation of the brand and its market."
                    class="alerta-letter">
                        A
                    </span>
                    <span style="--index:0.15s"
                    data-title="Leverage"
                    data-description="We stablish the brands opportunities for cultural connections. (Content, touch points, schedule)"
                    class="alerta-letter">
                        L
                    </span>
                    <span style="--index:0.2s"
                    data-title="Execute"
                    data-description="We roll out the campaign and start measuring the impact."
                    class="alerta-letter">
                        E
                    </span>
                    <span style="--index:0.25s"
                    data-title="Refine"
                    data-description="We optimize the creative based on social listening and sales data."
                    class="alerta-letter">
                        R
                    </span>
                    <span style="--index:0.3s"
                    data-title="Track"
                    data-description="We gather and analyze data and feedback while the campaign is active."
                    class="alerta-letter">
                        T
                    </span>
                    <span style="--index:0.35s"
                    data-title="Amplify"
                    data-description="We advance the objectives based on new opportunities discovered."
                    class="alerta-letter">
                        A
                    </span>
                    <em class="lines"></em>
                    <em class="line-point">
                        <b></b>
                    </em>
                </h4>
                <div class="dinamic-text">
                    <span class="dinamic-text-title"></span>
                    <span class="dinamic-text-description"></span>
                </div>
            </div>
        </article>
    </section>
    <!-- End planet with message alert-->

    <!-- Imagine brand limitless -->
    <section class="home-limitless">
        <div class="personality-animation" data-aos="personality">
            <article class="animation-tx-reveal">
                <h6 class="block-animation">
                    <span style="--index:0.3s">Imagine</span>
                </h6>
                <h6 class="block-animation">
                    <span style="--index:0.35s">Your</span>
                    <span style="--index:0.4s">Brand</span>
                    <span style="--index:0.45s">Limitless</span>
                </h6>
            </article>
        </div>
    </section>
    <!-- End imagine brand limitless -->


    <section id="modal-content">
        <div class="modal">
            <div class="modal__bg close-modal"></div>
            <div class="modal__content">
                
            </div>
        </div>
    </section>

    <!--THREE JS-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" type="text/javascript"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/83/three.min.js"></script>
    <script id="vertexShader" type="x-shader/x-vertex">
        varying vec3 vNormal; void main() { vNormal = normalize( normalMatrix * normal ); gl_Position = projectionMatrix * modelViewMatrix * vec4( position, 1.0 ); }
    </script>
    <script id="fragmentShader" type="x-shader/x-vertex">
        varying vec3 vNormal; void main() { float intensity = pow( 0.7 - dot( vNormal, vec3( 0.0, 0.0, 0.5 ) ), 4.0 ); gl_FragColor = vec4( 0.89, 0.82, 0.69, 1.0 ) * intensity; }
    </script>
    <script src="/themes/custom/alerta_theme/sources/dist/three/Planet.js"></script>
    <script src="/themes/custom/alerta_theme/sources/dist/three/PlanetHero.js" type="module"></script>
    <!--END THREE JS-->
    {% include directory ~ '/templates/includes/loader.html.twig' %}
</main>