    <!--RGB-->
    <section class="gradient">
        <article></article>
    </section>
    <!--End RGB-->

    <!--Planet three js-->
    <section class="home-planet personality-animation ctm-fonts ctn" data-aos="personality">
        <article>
            
        </article>
        <article class="animation-tx-reveal-secondary">
            <h5 class="rift">
                <span style="--index:0.1s">IN</span>
                <span style="--index:0.15s">A</span>
                <span style="--index:0.2s">WORLD</span>
