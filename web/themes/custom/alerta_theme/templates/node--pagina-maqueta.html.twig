                <span style="--index:0.3s"><b>STATE</b></span>
                <span style="--index:0.35s"><b>-</b></span>
                <span style="--index:0.45s">OF</span>
                <span style="--index:0.5s">-</span>
                <span style="--index:0.5s">THE</span>
                <span style="--index:0.5s">-</span>
                <span style="--index:0.5s">ART</span>
                <span style="--index:0.5s">RESOURCES</span>
