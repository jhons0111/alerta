    <!--RGB-->
    <section class="gradient">
        <article></article>
    </section>
    <!--End RGB-->

    <!--Planet three js-->
    <section class="home-planet personality-animation ctm-fonts ctn" data-aos="personality">
        <article>
            
        </article>
        <article class="animation-tx-reveal-secondary">
            <h5 class="rift">
                <span style="--index:0.3s">IN</span>
                <span style="--index:0.35s">A</span>
                <span style="--index:0.4s">WORLD</span>
                <span style="--index:0.45s">THAT</span>
                <span style="--index:0.5s">IS</span>
                <span style="--index:0.55s">BECOMING</span>
                <span style="--index:0.6s">MORE</span>
                <span style="--index:0.65s">CONECTED</span>
                <span style="--index:0.7s">NAVIGATING</span>
                <span style="--index:0.75s">BOUNDARIES</span>
